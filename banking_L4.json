[
  {"en":"I would like to open a checking account.","zh":"我想开个活期账户。","pattern":"would like to + 动词原形","words":[{"w":"I","ipa":"aɪ","pos":"pron"},{"w":"would","ipa":"wʊd","pos":"modal"},{"w":"like","ipa":"laɪk","pos":"v"},{"w":"to","ipa":"tə","pos":"part"},{"w":"open","ipa":"ˈəʊpən","pos":"v"},{"w":"a","ipa":"ə","pos":"art"},{"w":"checking","ipa":"ˈtʃekɪŋ","pos":"adj"},{"w":"account","ipa":"əˈkaʊnt","pos":"n"}],"chunks":[{"r":"subj","i":[0]},{"r":"pred","i":[1,2]},{"r":"objc","i":[3,4]},{"r":"obj","i":[5,6,7]}],"note":"checking account 美式叫活期账户,英式说 current account。"},
  {"en":"What documents do I need to bring?","zh":"我需要带什么证件?","pattern":"what + 名词 + do + 主语 + 动词","words":[{"w":"What","ipa":"wɒt","pos":"wh"},{"w":"documents","ipa":"ˈdɒkjəmənts","pos":"n"},{"w":"do","ipa":"duː","pos":"aux"},{"w":"I","ipa":"aɪ","pos":"pron"},{"w":"need","ipa":"niːd","pos":"v"},{"w":"to","ipa":"tə","pos":"part"},{"w":"bring","ipa":"brɪŋ","pos":"v"}],"chunks":[{"r":"obj","i":[0,1]},{"r":"marker","i":[2]},{"r":"subj","i":[3]},{"r":"pred","i":[4]},{"r":"objc","i":[5,6]}],"note":"documents 统称证件文件,比 papers 正式。"},
  {"en":"Can I withdraw money with this card?","zh":"这张卡能取现金吗?","pattern":"can + 主语 + 动词原形","words":[{"w":"Can","ipa":"kæn","pos":"modal"},{"w":"I","ipa":"aɪ","pos":"pron"},{"w":"withdraw","ipa":"wɪðˈdrɔː","pos":"v"},{"w":"money","ipa":"ˈmʌni","pos":"n"},{"w":"with","ipa":"wɪð","pos":"prep"},{"w":"this","ipa":"ðɪs","pos":"pron"},{"w":"card","ipa":"kɑːd","pos":"n"}],"chunks":[{"r":"marker","i":[0]},{"r":"subj","i":[1]},{"r":"pred","i":[2]},{"r":"obj","i":[3]},{"r":"advl","i":[4,5,6]}],"note":"withdraw money 是取款的标准说法。"},
  {"en":"How much is the monthly service fee?","zh":"每月服务费多少钱?","pattern":"how much + be + 主语","words":[{"w":"How","ipa":"haʊ","pos":"wh"},{"w":"much","ipa":"mʌtʃ","pos":"wh"},{"w":"is","ipa":"ɪz","pos":"v"},{"w":"the","ipa":"ðə","pos":"art"},{"w":"monthly","ipa":"ˈmʌnθli","pos":"adj"},{"w":"service","ipa":"ˈsɜːvɪs","pos":"n"},{"w":"fee","ipa":"fiː","pos":"n"}],"chunks":[{"r":"obj","i":[0,1]},{"r":"pred","i":[2]},{"r":"subj","i":[3,4,5,6]}],"note":"monthly service fee 月费,很多银行有免费条件。"},
  {"en":"I need to deposit this check today.","zh":"我今天得存这张支票。","pattern":"need to + 动词原形","words":[{"w":"I","ipa":"aɪ","pos":"pron"},{"w":"need","ipa":"niːd","pos":"v"},{"w":"to","ipa":"tə","pos":"part"},{"w":"deposit","ipa":"dɪˈpɒzɪt","pos":"v"},{"w":"this","ipa":"ðɪs","pos":"pron"},{"w":"check","ipa":"tʃek","pos":"n"},{"w":"today","ipa":"təˈdeɪ","pos":"adv"}],"chunks":[{"r":"subj","i":[0]},{"r":"pred","i":[1]},{"r":"objc","i":[2,3]},{"r":"obj","i":[4,5]},{"r":"advl","i":[6]}],"note":"deposit 存入,check 美式支票,英式 cheque。"},
