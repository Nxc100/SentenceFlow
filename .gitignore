crates/sf-wasm/pkg/
apps/web-trial/src/wasm/pkg/
apps/web-trial/public/wasm/

# Content build artifacts (source YAML stays in git; compiled DBs do not)
content/build/
*.db
*.db-journal

# Local packaging output / UI-test artifacts
dist-portable/
.playwright-mcp/

# 发布产物本地暂存区:二进制经 GitHub Releases 分发,不进 git 历史
# (exe 16MB + 安装包 5MB 无法增量压缩,入库会让仓库按提交次数线性膨胀;
#  发布流程见 doc/构建与发布手册.md §5.1)
release/

# Secrets — the Ed25519 issuer private key must NEVER enter the repository.
*.secret
*.pem
private-key*

# Editor/OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs / scratch
*.log

# 本地问题截图工作目录
fix/
